{
  "$id": "knowledge-engine/m26-pa-3-live-provider-receipt-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "credential_names": {"const": ["MINIMAX_API_KEY"]},
        "provider_calls": {"const": 1},
        "public_shadow_canary_traffic_operations": {"const": 0},
        "qdrant_write_operations": {"const": 0},
        "r2_write_operations": {"const": 0},
        "raw_text_persisted": {"const": false},
        "secret_values_persisted": {"const": false},
        "source_foundation_release_mutations": {"const": 0},
        "vectors_requested": {"const": false},
        "vectors_returned": {"const": false}
      },
      "required": [
        "provider_calls",
        "credential_names",
        "secret_values_persisted",
        "raw_text_persisted",
        "vectors_requested",
        "vectors_returned",
        "r2_write_operations",
        "qdrant_write_operations",
        "source_foundation_release_mutations",
        "public_shadow_canary_traffic_operations"
      ],
      "type": "object"
    },
    "authorization": {
      "additionalProperties": false,
      "properties": {
        "authorization_self_sha256": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
        "logical_attempt": {"const": 3},
        "trigger_marker": {"const": "[m26.pa3-provider-authorized-attempt-3]"}
      },
      "required": ["authorization_self_sha256", "logical_attempt", "trigger_marker"],
      "type": "object"
    },
    "generated_at": {"format": "date-time", "type": "string"},
    "provider": {
      "additionalProperties": false,
      "properties": {
        "api_style": {"const": "anthropic_compatible_messages"},
        "content_block_count": {"minimum": 0, "type": "integer"},
        "endpoint": {"const": "https://api.minimax.io/anthropic/v1/messages"},
        "model_id": {"const": "MiniMax-M3"},
        "provider_id": {"const": "minimax"},
        "provider_response_id": {"minLength": 1, "type": "string"},
        "response_json_sha256": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
        "response_model": {"minLength": 1, "type": "string"},
        "response_text_persisted": {"const": false},
        "response_text_sha256": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
        "stop_reason": {"type": ["string", "null"]}
      },
      "required": [
        "provider_id",
        "model_id",
        "api_style",
        "endpoint",
        "provider_response_id",
        "response_model",
        "stop_reason",
        "content_block_count",
        "response_json_sha256",
        "response_text_sha256",
        "response_text_persisted"
      ],
      "type": "object"
    },
    "request": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {"maximum": 256, "minimum": 1, "type": "integer"},
        "payload_sha256": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
        "prompt_bytes": {"maximum": 12000, "minimum": 1, "type": "integer"},
        "raw_corpus_text_sent": {"const": false},
        "stream": {"const": false},
        "user_query_sent": {"const": false},
        "vectors_sent": {"const": false}
      },
      "required": [
        "payload_sha256",
        "prompt_bytes",
        "max_output_tokens",
        "stream",
        "raw_corpus_text_sent",
        "vectors_sent",
        "user_query_sent"
      ],
      "type": "object"
    },
    "schema_version": {"const": "knowledge-engine-m26-pa-3-live-provider-receipt/v1"},
    "self_sha256": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "stage_id": {"const": "M26.PA.3"},
    "status": {"const": "live_provider_execution_verified"},
    "usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"minimum": 0, "type": "integer"},
        "output_tokens": {"minimum": 0, "type": "integer"},
        "total_tokens": {"minimum": 0, "type": "integer"}
      },
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "type": "object"
    },
    "workflow": {
      "additionalProperties": false,
      "properties": {
        "head_sha": {"pattern": "^[a-f0-9]{40}$", "type": "string"},
        "run_attempt": {"const": "1"},
        "run_id": {"minLength": 1, "type": "string"},
        "workflow_name": {"const": "M26.PA.3 Live Provider Execution Gate"}
      },
      "required": ["workflow_name", "run_id", "run_attempt", "head_sha"],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "stage_id",
    "status",
    "generated_at",
    "authorization",
    "workflow",
    "request",
    "provider",
    "usage",
    "authority",
    "self_sha256"
  ],
  "title": "M26.PA.3 live provider receipt",
  "type": "object"
}
