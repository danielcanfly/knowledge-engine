          "const": "2026-07-27T03:36:26Z"
        },
        "outcome": {
          "const": "approved_bounded_large_scale_ingestion"
        },
        "path": {
          "const": "pilot/m25/m25-10-owner-decision.json"
        }
      },
      "required": [
        "path",
        "outcome",
        "decided_at_utc"
      ],
      "type": "object"
    },
    "protected_mutations": {
      "additionalProperties": {
        "const": false
      },
      "type": "object"
    },
    "schema_version": {
      "const": "knowledge-engine-m25-10-formal-closure-evidence/v1"
