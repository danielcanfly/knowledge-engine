  "required": [
    "schema_version",
    "stage_id",
    "status",
    "generated_at",
    "workflow",
    "owner_decision",
    "population",
    "summary",
    "human_review_packet",
    "per_question_evidence",
    "authority",
    "self_sha256"
  ],
  "type": "object"
}
